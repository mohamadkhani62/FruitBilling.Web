@model List<FruitBilling.Web.Services.SheetImportReport>
@{
    var reportController = ViewData["ReportController"] as string ?? "Home";
    var isPreview = ViewData["IsImportPreview"] is bool preview && preview;
}
<hr />
@if (isPreview)
{
    <div class="alert alert-info border-primary" role="status">
        <b>🔎 پیش‌نمایش انجام شد؛ هیچ اطلاعاتی ذخیره نشده است.</b>
        تب‌های سبز قابل ثبت هستند؛ تب‌های قرمز خطا دارند و باید اصلاح شوند. هشدارها و توضیحات با رنگ زرد یا آبی نمایش داده می‌شوند.
    </div>
}
<h5>📑 گزارش ورود (به تفکیک تب)</h5>
@foreach (var rep in Model)
{
    if (rep.HasErrors)
    {
        <div class="alert alert-danger py-2 mb-2">
            <b>❌ تب «@rep.SheetName»</b>
            @if (rep.CycleName != null) { <span> — دوره «@rep.CycleName»</span> }
            <span> — ثبت نشد.</span>
            <ul class="mb-0 mt-1" style="font-size: 13px;">
                @foreach (var e in rep.Errors)
                {
                    <li>@e</li>
                }
                @if (rep.HiddenErrorCount > 0)
                {
                    <li>و @rep.HiddenErrorCount خطای دیگر…</li>
                }
            </ul>
            @if (rep.Notes.Any())
            {
                <div class="alert alert-warning py-2 mt-2 mb-0" role="status">
                    <b>⚠️ توضیحات و هشدارها:</b>
                    <ul class="mb-0 mt-1" style="font-size: 13px;">
                        @foreach (var n in rep.Notes)
                        {
                            <li>@n</li>
                        }
                    </ul>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-success py-2 mb-2">
            <b>✅ تب «@rep.SheetName»</b> — دوره «@rep.CycleName»:
            @if (isPreview)
            {
                <span>@rep.Permits برگه با @rep.Tickets قبض باسکول آماده ثبت است.</span>
            }
            else
            {
                <span>@rep.Permits برگه با @rep.Tickets قبض باسکول ثبت شد.</span>
            }
            @if (rep.Duplicates > 0) { <span>(@rep.Duplicates برگه‌ی تکراری نادیده گرفته شد)</span> }
            @if (rep.CycleId.HasValue)
            {
                <a asp-controller="@reportController" asp-action="Index" asp-route-cycleId="@rep.CycleId" class="btn btn-sm btn-outline-success ms-2">مشاهده</a>
            }
            @if (rep.Notes.Any())
            {
                <div class="alert alert-info py-2 mt-2 mb-0" role="status">
                    <b>ℹ️ توضیحات:</b>
                    <ul class="mb-0 mt-1" style="font-size: 12px;">
                        @foreach (var n in rep.Notes)
                        {
                            <li>@n</li>
                        }
                    </ul>
                </div>
            }
        </div>
    }
}
