@model FruitBilling.Web.Models.Tree
@{
    ViewData["Title"] = "افزودن درخت";
}

<style>
    body {
        direction: rtl;
        font-family: Tahoma, sans-serif;
    }

    .form-card {
        max-width: 700px;
        margin: 30px auto;
        padding: 25px;
        background: #fff;
        border: 1px solid #81c784;
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    }

        .form-card h3 {
            color: #1b5e20;
            margin-bottom: 20px;
            border-bottom: 2px solid #c8e6c9;
            padding-bottom: 10px;
        }

    .form-label {
        font-weight: bold;
        font-size: 13px;
        color: #1b5e20;
    }
</style>

<div class="form-card">
    <h3>🌳 افزودن درخت جدید</h3>

    <form asp-action="CreateTree" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="TreeRowId" value="@ViewBag.PlotId" />
        <input type="hidden" name="Latitude" id="latInput" value="0" />
        <input type="hidden" name="Longitude" id="lngInput" value="0" />

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Number" class="form-label">شماره درخت *</label>
                <input asp-for="Number" class="form-control" type="number" required />
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="ProductType" class="form-label">نوع درخت *</label>
                <select asp-for="ProductType" class="form-select" required>
                    <option value="">-- انتخاب کنید --</option>
                    <option value="والنسیا">والنسیا</option>
                    <option value="مارس">مارس</option>
                    <option value="گریپ قرمز">گریپ قرمز</option>
                    <option value="ناول">ناول</option>
                    <option value="نارنگی پرل">نارنگی پرل</option>
                    <option value="نارنگی اورلاندو">نارنگی اورلاندو</option>
                    <option value="نارنگی کینو">نارنگی کینو</option>
                    <option value="نارنگی مینولاتانجلو">نارنگی مینولاتانجلو</option>
                    <option value="نارنگی کارا">نارنگی کارا</option>
                    <option value="محلی">محلی</option>
                </select>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">عرض جغرافیایی (Latitude) *</label>
            <input class="form-control" type="number" step="0.000001" id="latVisible"
                   value="28.542" onchange="document.getElementById('latInput').value = this.value" required />
        </div>

        <div class="mb-3">
            <label class="form-label">طول جغرافیایی (Longitude) *</label>
            <input class="form-control" type="number" step="0.000001" id="lngVisible"
                   value="57.854" onchange="document.getElementById('lngInput').value = this.value" required />
        </div>

        <div class="mb-3">
            <label asp-for="HealthStatus" class="form-label">وضعیت سلامت</label>
            <select asp-for="HealthStatus" class="form-select">
                <option value="سالم">سالم</option>
                <option value="بیمار">بیمار</option>
                <option value="خشک">خشک</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="Notes" class="form-label">توضیحات</label>
            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
        </div>

        <div class="text-end">
            <button type="submit" class="btn btn-success">💾 ذخیره</button>
            <a asp-action="Index" class="btn btn-secondary">بازگشت</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // همگام‌سازی ورودی‌های visible با hidden در بارگذاری اولیه
        document.getElementById('latInput').value = document.getElementById('latVisible').value;
        document.getElementById('lngInput').value = document.getElementById('lngVisible').value;
    </script>
}