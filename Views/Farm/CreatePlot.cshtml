@model FruitBilling.Web.Models.Plot

@{
    ViewData["Title"] = "افزودن قطعه";
}

<style>
    body {
        direction: rtl;
        font-family: Tahoma, sans-serif;
    }

    .form-card {
        max-width: 700px;
        margin: 30px auto;
        padding: 25px;
        background: #fff;
        border: 1px solid #ffb74d;
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    }

        .form-card h3 {
            color: #e65100;
            margin-bottom: 20px;
            border-bottom: 2px solid #ffe0b2;
            padding-bottom: 10px;
        }

    .form-label {
        font-weight: bold;
        font-size: 13px;
        color: #e65100;
    }
</style>

<div class="form-card">
    <h3>🟫 افزودن قطعه جدید</h3>

    <form asp-action="CreatePlotForm" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="FarmId" value="@ViewBag.FarmId" />

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label class="form-label">مزرعه</label>
            <input class="form-control" value="مزرعه #@ViewBag.FarmId" disabled />
        </div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">نام قطعه *</label>
            <input asp-for="Name" class="form-control" required placeholder="مثلاً قطعه A" />
        </div>

        <div class="mb-3">
            <label asp-for="AreaHectare" class="form-label">مساحت (هکتار)</label>
            <input asp-for="AreaHectare" class="form-control" type="number" step="0.01" />
        </div>

        <div class="mb-3">
            <label asp-for="SectionCount" class="form-label">تعداد قسمت</label>
            <input asp-for="SectionCount" class="form-control" type="number" value="1" />
        </div>

        <div class="mb-3">
            <label asp-for="SectionGapMeters" class="form-label">عرض مسیر عبور (متر)</label>
            <input asp-for="SectionGapMeters" class="form-control" type="number" step="0.1" value="0" />
        </div>

        <div class="mb-3">
            <label class="form-label">مختصات مرز (JSON)</label>
            <textarea asp-for="CoordinatesJson" class="form-control" rows="4"
                      placeholder='[{"lat":28.542,"lng":57.854}, ...]'></textarea>
        </div>

        <div class="text-end">
            <button type="submit" class="btn btn-warning">💾 ذخیره</button>
            <a asp-action="Index" class="btn btn-secondary">بازگشت</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}