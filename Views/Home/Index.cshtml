@{
    ViewData["Title"] = "داشبورد مدیریت";
    // 🆕 تبدیل ایمن داده‌های dynamic به نوع مشخص
    var productNames = ViewBag.ProductNames as List<string> ?? new List<string>();
    var productWeights = ViewBag.ProductWeights as List<decimal> ?? new List<decimal>();

    var productNamesJson = System.Text.Json.JsonSerializer.Serialize(productNames);
    var productWeightsJson = System.Text.Json.JsonSerializer.Serialize(productWeights);
}

<style>
    body {
        direction: rtl;
        font-family: Tahoma, sans-serif;
        background-color: #f4f6f9;
    }

    .dashboard-container {
        max-width: 1200px;
        margin: 30px auto;
        padding: 0 15px;
    }

    .welcome-header {
        text-align: center;
        margin-bottom: 40px;
        color: #2c3e50;
    }

        .welcome-header h1 {
            font-weight: bold;
            font-size: 20px;
        }

    .card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }

    .dash-card {
        background: #fff;
        border-radius: 12px;
        padding: 25px 20px;
        text-align: center;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        text-decoration: none;
        color: #333;
        display: flex;
        flex-direction: column;
        align-items: center;
        border-top: 5px solid transparent;
    }

        .dash-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
            color: #333;
        }

        .dash-card .icon {
            font-size: 40px;
            margin-bottom: 15px;
        }

        .dash-card h3 {
            font-size: 18px;
            margin-bottom: 10px;
            font-weight: bold;
        }

        .dash-card p {
            font-size: 13px;
            color: #777;
            margin: 0;
        }

    /* رنگ‌بندی کارت‌ها */
    .card-exit {
        border-top-color: #e67e22;
    }

        .card-exit .icon {
            color: #e67e22;
        }

    .card-records {
        border-top-color: #3498db;
    }

        .card-records .icon {
            color: #3498db;
        }

    .card-farms {
        border-top-color: #2ecc71;
    }

        .card-farms .icon {
            color: #2ecc71;
        }

    .card-map {
        border-top-color: #9b59b6;
    }

        .card-map .icon {
            color: #9b59b6;
        }

    .card-dashboard {
        border-top-color: #e91e63;
    }

        .card-dashboard .icon {
            color: #e91e63;
        }
</style>

<div class="dashboard-container">
    <div class="welcome-header">
        <h1>سامانه مدیریت کشت و صنعت جیرفت (سهامی خاض)</h1>
        <p>به داشبورد مدیریت خوش آمدید. لطفاً بخش مورد نظر خود را انتخاب کنید.</p>
    </div>

    <div class="card-grid">
        <!-- صدور برگ خروج -->
        <a href="/ExitPermits" class="dash-card card-exit">
            <div class="icon">🚜</div>
            <h3>صدور برگ خروج</h3>
            <p>ثبت برداشت و توزین باسکول</p>
        </a>

        <!-- مدیریت مزارع -->
        <a href="/Farm" class="dash-card card-farms">
            <div class="icon">🌾</div>
            <h3>مدیریت مزارع</h3>
            <p>قطعات، درختان و نقشه سه‌بعدی</p>
        </a>

@*         <!-- بارنامه‌ها و حسابداری -->
        <a href="/FruitRecords" class="dash-card card-records">
            <div class="icon">📊</div>
            <h3>مدیریت بارنامه‌ها</h3>
            <p>ورود و خروجی اکسل، فیلترها</p>
        </a> *@

        <!-- 🆕 داشبورد عملکرد -->
@*         <a href="/Home/Dashboard" class="dash-card card-dashboard">
            <div class="icon">📈</div>
            <h3>داشبورد عملکرد</h3>
            <p>نمودارها و آمار ورود محصولات</p>
        </a> *@

        <!-- نقشه سه‌بعدی -->
        <a href="/Home/Map3DViewer" class="dash-card card-map">
            <div class="icon">🗺️</div>
            <h3>نمای سه‌بعدی</h3>
            <p>مشاهده مزارع و قطعات روی نقشه</p>
        </a>

        <!--  صدور برگ خروج از ردخانه / سورتینگ  -->
        <a href="/SortingExitPermits" class="dash-card card-records" style="border-top-color: #f39c12;">
            <div class="icon" style="color: #f39c12;">🍏</div>
            <h3>خروج سورتینگ</h3>
            <p>صدور برگه و توزین محصولات سورت شده</p>
        </a>

    </div>

    <!-- 🆕 نمودار کلی در صفحه اصلی -->
    <div class="card shadow-sm mt-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">📊 مجموع وزن خالص به تفکیک محصول (کیلوگرم)</h5>
        </div>
        <div class="card-body">
            <div style="position: relative; height:400px; width:100%;">
                <canvas id="productChart"></canvas>
            </div>
        </div>
    </div>
</div>

<script src="~/lib/chart.umd.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // خواندن داده‌ها از C# (به صورت ایمن)
        const labels = @Html.Raw(productNamesJson);
        const dataValues = @Html.Raw(productWeightsJson);

        if (!labels || labels.length === 0) {
            document.getElementById('productChart').outerHTML = '<p class="text-center text-muted">داده‌ای برای نمایش وجود ندارد.</p>';
            return;
        }

        const ctx = document.getElementById('productChart').getContext('2d');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'وزن خالص (kg)',
                    data: dataValues,
                    backgroundColor: 'rgba(54, 162, 235, 0.7)',
                    borderColor: 'rgba(54, 162, 235, 1)',
                    borderWidth: 1,
                    borderRadius: 5
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true } }
            }
        });
    });
</script>