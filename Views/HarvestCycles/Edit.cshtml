@model FruitBilling.Web.Models.HarvestCycle
@{
    ViewData["Title"] = "ویرایش دوره برداشت";
}

<div class="container mt-4" style="max-width: 700px; direction: rtl; font-family: Tahoma;">
    <h2>✏️ ویرایش دوره برداشت</h2>

    <form asp-action="Edit" method="post" class="card p-4 shadow-sm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Name" class="form-label fw-bold"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="Year" class="form-label fw-bold"></label>
                <input asp-for="Year" class="form-control" type="number" />
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="CycleNumber" class="form-label fw-bold"></label>
                <input asp-for="CycleNumber" class="form-control" type="number" min="1" max="3" />
            </div>

            <!-- 🆕 انتخاب گونه -->
            <div class="col-md-12 mb-3">
                <label asp-for="CategoryId" class="form-label fw-bold">گونه مربوطه</label>
                <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                    <option value="">-- انتخاب گونه --</option>
                </select>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="StartDate" class="form-label fw-bold"></label>
                <input asp-for="StartDate" class="form-control" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="EndDate" class="form-label fw-bold"></label>
                <input asp-for="EndDate" class="form-control" />
            </div>
        </div>

        <div class="text-end">
            <button type="submit" class="btn btn-primary">💾 ذخیره تغییرات</button>
            <a asp-action="Index" class="btn btn-secondary">بازگشت</a>
        </div>
    </form>
</div>