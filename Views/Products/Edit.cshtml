@model FruitBilling.Web.Models.Product
@{
    ViewData["Title"] = "ویرایش محصول";
}

<div class="container mt-4" style="max-width: 600px; direction: rtl; font-family: Tahoma;">
    <h2>✏️ ویرایش محصول</h2>

    <form asp-action="Edit" method="post" class="card p-4 shadow-sm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="All" class="text-danger"></div>

        <!-- 🆕 انتخاب گونه -->
        <div class="mb-3">
            <label asp-for="CategoryId" class="form-label fw-bold">گونه مربوطه</label>
            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                <option value="">-- انتخاب گونه --</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label fw-bold"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label fw-bold"></label>
            <input asp-for="Description" class="form-control" />
        </div>

        <div class="text-end">
            <button type="submit" class="btn btn-primary">💾 ذخیره تغییرات</button>
            <a asp-action="Index" class="btn btn-secondary">بازگشت</a>
        </div>
    </form>
</div>