@model FruitBilling.Web.Models.Product
@{
    ViewData["Title"] = "افزودن محصول";
}

<div class="container mt-4" style="max-width: 600px; direction: rtl; font-family: Tahoma;">
    <h2>➕ افزودن محصول جدید</h2>

    <form asp-action="Create" method="post" class="card p-4 shadow-sm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger"></div>

        <!-- 🆕 انتخاب گونه -->
        <div class="mb-3">
            <label asp-for="CategoryId" class="form-label fw-bold">گونه مربوطه</label>
            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                <option value="">-- انتخاب گونه (مثلاً مرکبات) --</option>
            </select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
            @if (ViewBag.Categories == null || ((SelectList)ViewBag.Categories).Count() == 0)
            {
                <small class="text-danger">⚠️ هیچ گونه‌ای تعریف نشده. ابتدا از منوی «اطلاعات پایه > گونه‌ها» یک گونه بسازید.</small>
            }
        </div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label fw-bold"></label>
            <input asp-for="Name" class="form-control" placeholder="مثلاً پرتقال، سیب‌زمینی، خرما" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label fw-bold"></label>
            <input asp-for="Description" class="form-control" />
        </div>

        <div class="text-end">
            <button type="submit" class="btn btn-success">💾 ذخیره</button>
            <a asp-action="Index" class="btn btn-secondary">بازگشت</a>
        </div>
    </form>
</div>