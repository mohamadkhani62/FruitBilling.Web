@model FruitBilling.Web.Models.SortingExitPermit
@{
    ViewData["Title"] = "توزین سورتینگ";
    var currentUserId = UserManager.GetUserId(User)!;
    var perms = await PermissionService.GetEditableFieldsAsync(currentUserId, "SortingExitPermits", Model);

    bool canEditTicketNo = perms.GetValueOrDefault("TicketNo_Sort");
    bool canEditBasketCount = perms.GetValueOrDefault("BasketCount_Sort");
    bool canEditEmptyWeight = perms.GetValueOrDefault("EmptyWeight_Sort");
    bool canEditGrossWeight = perms.GetValueOrDefault("GrossWeight_Sort");
    bool canEditAnyTicketField = canEditTicketNo || canEditBasketCount || canEditEmptyWeight || canEditGrossWeight;
    bool canManageTicketRows = canEditTicketNo && canEditBasketCount && canEditEmptyWeight && canEditGrossWeight;
    var serverWarning = TempData["Warning"]?.ToString();
    var serverMessage = TempData["Msg"]?.ToString();
}
<style>
    body { direction: rtl; font-family: Tahoma, sans-serif; }
    .card-form { max-width: 1100px; margin: 20px auto; padding: 20px; border: 2px solid #ffb74d; border-radius: 8px; background: #fff8e1; }
    .info-box { background: #e3f2fd; padding: 15px; border-radius: 8px; margin-bottom: 20px; font-size: 14px; }
    .item-box { background: #fff; border: 1px solid #ddd; border-radius: 8px; padding: 15px; margin-bottom: 18px; }
    .ticket-row { background: #fafafa; padding: 10px; border: 1px solid #ddd; border-radius: 5px; margin-bottom: 10px; transition: background-color .15s, border-color .15s; }
    .ticket-row.validation-error { background: #fff0f0; border: 2px solid #dc3545; }
    .ticket-row.validation-ok { background: #eef9f0; border: 1px solid #198754; }
    .item-box.validation-error { background: #fff3f3; border: 2px solid #dc3545; }
    .item-box.validation-ok { background: #f0faf2; border: 2px solid #198754; }
    .item-box.server-warning:not(.validation-error) { background: #fff8df; border: 2px solid #e0a800; }
    .ticket-message { display: none; }
    .ticket-message.show { display: block; }
    .item-validation { display: none; }
    .item-validation.show { display: block; }
    .readonly-field { background-color: #e9ecef !important; cursor: not-allowed; }
</style>

<h2 style="text-align:center; color:#e65100;">⚖️ ثبت توزین سورتینگ</h2>
@if (!string.IsNullOrWhiteSpace(serverWarning))
{
    <div class="alert alert-warning text-center" role="alert">⚠️ @serverWarning</div>
}
@if (!string.IsNullOrWhiteSpace(serverMessage))
{
    <div class="alert alert-success text-center" role="status">✅ @serverMessage</div>
}

@if (!canEditAnyTicketField)
{
    <div class="alert alert-danger text-center mt-5">
        <h4>⛔ دسترسی غیرمجاز</h4>
        <p>شما برای هیچ‌یک از فیلدهای قبض باسکول مجوز ویرایش ندارید.</p>
        <a asp-action="Index" asp-route-cycleId="@(Model.HarvestCycleId ?? 0)" asp-route-focusId="@Model.Id" class="btn btn-secondary">بازگشت</a>
    </div>
    return;
}

<div class="card-form">
    <div class="info-box">
        <strong>شماره مجوز تحویل:</strong> @Model.PermitNumber |
        <strong>مزرعه:</strong> @Model.FarmName |
        <strong>پلاک:</strong> @Model.VehiclePlate |
        <strong>مقصد:</strong> @Model.Destination
    </div>

    <form asp-action="Weigh" method="post" id="weighForm" novalidate
      data-server-warning="@(string.IsNullOrWhiteSpace(serverWarning) ? "false" : "true")">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <h4>توزین به تفکیک رقم و درجه</h4>
        <div class="small d-flex flex-wrap gap-3 mb-3" aria-label="راهنمای رنگ وضعیت">
            <span><span class="badge bg-success">سبز</span> اطلاعات معتبر</span>
            <span><span class="badge bg-danger">قرمز</span> خطا و مانع ثبت</span>
            <span><span class="badge bg-warning text-dark">زرد</span> نیازمند بررسی هشدار سرور</span>
        </div>

        @for (var i = 0; i < Model.Items.Count; i++)
        {
            var item = Model.Items[i];
            var existing = item.BasculTickets?.ToList() ?? new List<FruitBilling.Web.Models.SortingBasculTicket>();
            if (existing.Count == 0) existing.Add(new FruitBilling.Web.Models.SortingBasculTicket());

            <div class="item-box weigh-item"
                 data-item-index="@i"
                 data-basket-total="@item.BasketCount"
                 data-can-edit-baskets="@canEditBasketCount.ToString().ToLowerInvariant()"
                 data-can-manage-rows="@canManageTicketRows.ToString().ToLowerInvariant()">
                <input type="hidden" name="Items[@i].Id" value="@item.Id" />
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">@(item.Variety?.Product?.Name) - @(item.Variety?.Name) | @item.Grade</h5>
                    <strong>کل سبد این ردیف: @item.BasketCount</strong>
                </div>

                <div class="tickets-container">
                    @for (var j = 0; j < existing.Count; j++)
                    {
                        var ticket = existing[j];
                        <div class="ticket-row row">
                            <input type="hidden" name="Items[@i].BasculTickets[@j].Id" value="@ticket.Id" />

                            <div class="col-md-2 mb-2">
                                <label>شماره قبض</label>
                                <input name="Items[@i].BasculTickets[@j].TicketNo"
                                       value="@ticket.TicketNo"
                                       class="form-control ticket-no @(canEditTicketNo ? "" : "readonly-field")"
                                       readonly="@(!canEditTicketNo)" required />
                            </div>

                            <div class="col-md-2 mb-2">
                                <label>تعداد سبد قبض</label>
                                <input name="Items[@i].BasculTickets[@j].BasketCount"
                                       value="@(existing.Count == 1 ? item.BasketCount : ticket.BasketCount)"
                                       class="form-control ticket-baskets @(canEditBasketCount && existing.Count > 1 ? "" : "readonly-field")"
                                       type="number" min="1"
                                       readonly="@(existing.Count == 1 || !canEditBasketCount)" required />
                            </div>

                            <div class="col-md-2 mb-2">
                                <label>وزن خالی (kg)</label>
                                <input name="Items[@i].BasculTickets[@j].EmptyWeight"
                                       value="@(ticket.Id == 0 ? "" : ticket.EmptyWeight)"
                                       class="form-control empty-weight @(canEditEmptyWeight ? "" : "readonly-field")"
                                       type="number" min="0" readonly="@(!canEditEmptyWeight)"
                                       required oninput="calcNet(this)" />
                            </div>

                            <div class="col-md-2 mb-2">
                                <label>وزن پر (kg)</label>
                                <input name="Items[@i].BasculTickets[@j].GrossWeight"
                                       value="@(ticket.Id == 0 ? "" : ticket.GrossWeight)"
                                       class="form-control gross-weight @(canEditGrossWeight ? "" : "readonly-field")"
                                       type="number" min="1" readonly="@(!canEditGrossWeight)"
                                       required oninput="calcNet(this)" />
                            </div>

                            <div class="col-md-2 mb-2">
                                <label>وزن خالص (kg)</label>
                                <input name="Items[@i].BasculTickets[@j].NetWeight"
                                       value="@(ticket.Id == 0 ? "" : ticket.NetWeight)"
                                       class="form-control net-weight readonly-field" readonly />
                            </div>

                            <div class="col-md-2 mb-2 d-flex align-items-end">
                                <button type="button" class="btn btn-outline-danger w-100"
                                        onclick="removeTicket(this)"
                                        disabled="@(existing.Count == 1 || !canManageTicketRows)">حذف</button>
                            </div>
                            <div class="col-12 ticket-message small rounded px-2 py-1" role="alert"></div>
                        </div>
                    }
                </div>
                <div class="item-validation small rounded px-3 py-2 mb-2" role="alert"></div>

                <button type="button" class="btn btn-outline-primary btn-sm"
                        onclick="addTicket(this)" disabled="@(!canManageTicketRows)">
                    ➕ افزودن قبض برای این درجه
                </button>
                <div class="small text-muted mt-2">
                    مجموع تعداد سبد قبض‌ها باید دقیقاً برابر تعداد سبد این ردیف باشد.
                    @if (!canManageTicketRows)
                    {
                        <span>افزودن یا حذف قبض به مجوز ویرایش هر چهار فیلد قبض نیاز دارد.</span>
                    }
                </div>
            </div>
        }

        @if (Model.Items.Count == 0)
        {
            <div class="alert alert-warning">برای این برگه هنوز ردیف رقم/درجه ثبت نشده است.</div>
        }

        <div id="clientValidationSummary" class="alert alert-danger text-center mt-3 d-none" role="alert"></div>
        <div class="alert alert-success text-center mt-3">
            <h4>مجموع وزن خالص: <span id="totalNetWeightDisplay">0</span> کیلوگرم</h4>
        </div>

        <div class="text-end mt-4">
            <button type="submit" class="btn btn-success" disabled="@(Model.Items.Count == 0)">✅ ذخیره فیلدهای مجاز</button>
            <a asp-action="Index" asp-route-cycleId="@(Model.HarvestCycleId ?? 0)" asp-route-focusId="@Model.Id" class="btn btn-secondary">بازگشت</a>
        </div>
    </form>
</div>

@section Scripts {
<script>
    function reindexTickets(itemBox) {
        const itemIndex = itemBox.dataset.itemIndex;
        const rows = itemBox.querySelectorAll('.ticket-row');
        rows.forEach((row, index) => {
            row.querySelectorAll('input').forEach(input => {
                const field = input.name.substring(input.name.lastIndexOf('.') + 1);
                input.name = 'Items[' + itemIndex + '].BasculTickets[' + index + '].' + field;
            });

            const basketInput = row.querySelector('.ticket-baskets');
            const singleTicket = rows.length === 1;
            basketInput.readOnly = singleTicket || itemBox.dataset.canEditBaskets !== 'true';
            if (singleTicket) basketInput.value = itemBox.dataset.basketTotal;

            const removeButton = row.querySelector('button');
            removeButton.disabled = singleTicket || itemBox.dataset.canManageRows !== 'true';
        });
    }

    function addTicket(button) {
        const box = button.closest('.weigh-item');
        if (button.disabled) return;
        const container = box.querySelector('.tickets-container');
        const source = container.querySelector('.ticket-row');
        if (!source) return;
        const clone = source.cloneNode(true);
        clone.querySelectorAll('input').forEach(input => input.value = '');
        clone.dataset.touched = 'false';
        clone.classList.remove('validation-error', 'validation-ok');
        const feedback = clone.querySelector('.ticket-message');
        if (feedback) { feedback.textContent = ''; feedback.classList.remove('show'); }
        container.appendChild(clone);
        reindexTickets(box);
        validateItem(box, false);
        calcTotal();
    }

    function removeTicket(button) {
        const box = button.closest('.weigh-item');
        if (button.disabled || box.querySelectorAll('.ticket-row').length <= 1) return;
        button.closest('.ticket-row').remove();
        reindexTickets(box);
        validateItem(box, false);
        calcTotal();
    }

    function calcNet(input) {
        const row = input.closest('.ticket-row');
        const emptyRaw = row.querySelector('.empty-weight').value.trim();
        const grossRaw = row.querySelector('.gross-weight').value.trim();
        const empty = emptyRaw === '' ? NaN : Number(emptyRaw);
        const gross = grossRaw === '' ? NaN : Number(grossRaw);
        row.querySelector('.net-weight').value =
            Number.isInteger(empty) && Number.isInteger(gross) && gross > empty ? gross - empty : '';
        calcTotal();
    }

    function parseInteger(input) {
        const raw = input ? input.value.trim() : '';
        if (raw === '') return null;
        const value = Number(raw);
        return Number.isInteger(value) ? value : null;
    }

    function validateItem(itemBox, forceShow) {
        const rows = Array.from(itemBox.querySelectorAll('.ticket-row'));
        const targetBasketCount = Number(itemBox.dataset.basketTotal);
        const itemErrors = [];
        let basketSum = 0;
        let allRowsValid = rows.length > 0;
        let hasAnyTicketData = false;
        let invalidBasketCount = false;

        rows.forEach(row => {
            const ticketNoInput = row.querySelector('.ticket-no');
            const basketInput = row.querySelector('.ticket-baskets');
            const emptyInput = row.querySelector('.empty-weight');
            const grossInput = row.querySelector('.gross-weight');
            const ticketNo = ticketNoInput.value.trim();
            const emptyRaw = emptyInput.value.trim();
            const grossRaw = grossInput.value.trim();
            const empty = parseInteger(emptyInput);
            const gross = parseInteger(grossInput);

            if (rows.length === 1) basketInput.value = String(targetBasketCount);
            const basket = parseInteger(basketInput);

            const rowErrors = [];
            if (ticketNo || emptyRaw || grossRaw || row.dataset.touched === 'true') hasAnyTicketData = true;

            if (!ticketNo) rowErrors.push('شماره قبض الزامی است.');
            else if (ticketNo.length > 30) rowErrors.push('شماره قبض نباید بیش از ۳۰ کاراکتر باشد.');

            if (emptyRaw === '' || empty === null) rowErrors.push('وزن خالی باید عدد صحیح وارد شود.');
            else if (empty < 0) rowErrors.push('وزن خالی نمی‌تواند منفی باشد.');

            if (grossRaw === '' || gross === null) rowErrors.push('وزن پر باید عدد صحیح وارد شود.');
            else if (empty !== null && gross <= empty) rowErrors.push('وزن پر باید از وزن خالی بیشتر باشد.');

            if (rows.length > 1) {
                if (basket === null || basket <= 0) {
                    rowErrors.push('تعداد سبد قبض باید عدد صحیح مثبت باشد.');
                    invalidBasketCount = true;
                } else {
                    basketSum += basket;
                }
            } else {
                basketSum = targetBasketCount;
            }

            const showRow = forceShow || row.dataset.touched === 'true' ||
                ((ticketNo !== '' || emptyRaw !== '' || grossRaw !== '') && rowErrors.length > 0);
            row.classList.remove('validation-error', 'validation-ok');
            const feedback = row.querySelector('.ticket-message');
            if (showRow && rowErrors.length > 0) {
                row.classList.add('validation-error');
                feedback.textContent = rowErrors.join(' ');
                feedback.classList.add('show');
                allRowsValid = false;
            } else if (showRow) {
                row.classList.add('validation-ok');
                feedback.textContent = 'اطلاعات این قبض معتبر است.';
                feedback.classList.add('show');
            } else {
                feedback.textContent = '';
                feedback.classList.remove('show');
            }
        });

        if (invalidBasketCount) itemErrors.push('تعداد سبد یک یا چند قبض معتبر نیست.');
        if (!invalidBasketCount && basketSum !== targetBasketCount) {
            itemErrors.push('مجموع سبد قبض‌ها (' + basketSum + ') باید دقیقاً برابر ' + targetBasketCount + ' باشد.');
        }
        if (rows.length === 0) itemErrors.push('حداقل یک قبض برای این ردیف لازم است.');

        const showItem = forceShow || itemBox.dataset.touched === 'true' || hasAnyTicketData;
        itemBox.classList.remove('validation-error', 'validation-ok');
        const itemFeedback = itemBox.querySelector('.item-validation');
        if (showItem && (itemErrors.length > 0 || !allRowsValid)) {
            itemBox.classList.add('validation-error');
            itemFeedback.textContent = itemErrors.length ? itemErrors.join(' ') : 'اطلاعات یکی از قبض‌ها ناقص یا نامعتبر است.';
            itemFeedback.classList.add('show');
        } else if (showItem) {
            itemBox.classList.add('validation-ok');
            itemFeedback.textContent = 'تعداد سبد و قبض‌های این ردیف معتبر است.';
            itemFeedback.classList.add('show');
        } else {
            itemFeedback.textContent = '';
            itemFeedback.classList.remove('show');
        }

        return allRowsValid && itemErrors.length === 0;
    }

    function calcTotal() {
        let total = 0;
        document.querySelectorAll('.net-weight').forEach(input => total += Number(input.value) || 0);
        document.getElementById('totalNetWeightDisplay').innerText = total.toLocaleString('en-US');
    }

    const weighForm = document.getElementById('weighForm');
    const validationSummary = document.getElementById('clientValidationSummary');

    weighForm.addEventListener('input', event => {
        const row = event.target.closest('.ticket-row');
        if (!row) return;
        row.dataset.touched = 'true';
        const itemBox = row.closest('.weigh-item');
        validateItem(itemBox, false);
        calcTotal();
    });

    weighForm.addEventListener('submit', event => {
        let invalidItems = 0;
        let firstInvalid = null;
        document.querySelectorAll('.weigh-item').forEach(itemBox => {
            if (!validateItem(itemBox, true)) {
                invalidItems++;
                if (!firstInvalid) firstInvalid = itemBox;
            }
        });

        if (invalidItems > 0) {
            event.preventDefault();
            validationSummary.textContent = invalidItems + ' ردیف رقم/درجه دارای خطا است. موارد قرمز را اصلاح کنید؛ تا رفع خطا اطلاعات ذخیره نمی‌شود.';
            validationSummary.classList.remove('d-none');
            validationSummary.scrollIntoView({ behavior: 'smooth', block: 'center' });
            firstInvalid?.querySelector('.validation-error input:not([readonly])')?.focus();
        } else {
            validationSummary.classList.add('d-none');
        }
    });

    document.querySelectorAll('.weigh-item').forEach(itemBox => {
        reindexTickets(itemBox);
        validateItem(itemBox, false);
        if (weighForm.dataset.serverWarning === 'true') itemBox.classList.add('server-warning');
    });
    calcTotal();
</script>
}
