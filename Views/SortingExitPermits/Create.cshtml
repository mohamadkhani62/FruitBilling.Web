@model FruitBilling.Web.Models.SortingExitPermit
@{
    ViewData["Title"] = "صدور مجوز تحویل سورتینگ";
    var currentUserId = UserManager.GetUserId(User)!;
    var perms = await PermissionService.GetEditableFieldsAsync(currentUserId, "SortingExitPermits", new FruitBilling.Web.Models.SortingExitPermit());

    bool canCreate = perms.Values.Any(v => v == true);
    if (!canCreate)
    {
        <div class="alert alert-danger mt-5 text-center">
            <h4>⛔ دسترسی غیرمجاز</h4>
            <p>شما دسترسی صدور مجوز تحویل سورتینگ را ندارید.</p>
            <a href="/SortingExitPermits" class="btn btn-secondary">بازگشت</a>
        </div>
        return;
    }
}

<style>
    body {
        direction: rtl;
        font-family: Tahoma, sans-serif;
    }

    .card-form {
        max-width: 1000px;
        margin: 20px auto;
        padding: 20px;
        border: 1px solid #ddd;
        border-radius: 8px;
        background: #fafafa;
    }

    .form-label {
        font-weight: bold;
        font-size: 13px;
    }

    .readonly-field {
        background-color: #e9ecef !important;
        cursor: not-allowed;
    }

    .section-title {
        font-size: 14px;
        font-weight: bold;
        color: #0d47a1;
        border-bottom: 2px solid #bbdefb;
        padding-bottom: 5px;
        margin-bottom: 15px;
        margin-top: 20px;
    }
</style>

<h2 style="text-align:center;">🍏 صدور مجوز تحویل از سورتینگ</h2>

<div class="card-form">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="HarvestCycleId" />
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        @{ var currentCycle = ViewBag.CurrentCycle as FruitBilling.Web.Models.HarvestCycle; }
        @if (currentCycle != null)
        {
            <div class="alert alert-success py-2">🌱 دوره برداشت: <b>@currentCycle.Name</b> (@currentCycle.Year)</div>
        }

        <div class="section-title">📄 اطلاعات مجوز تحویل</div>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="PermitNumber" class="form-label">شماره مجوز تحویل *</label>
                <input asp-for="PermitNumber" class="form-control @(perms.GetValueOrDefault("PermitNumber") ? "" : "readonly-field")" readonly="@(!perms.GetValueOrDefault("PermitNumber"))" maxlength="15" required />
                <span asp-validation-for="PermitNumber" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Date" class="form-label"></label>
                <input asp-for="Date" class="form-control @(perms.GetValueOrDefault("Date") ? "" : "readonly-field")" readonly="@(!perms.GetValueOrDefault("Date"))" />
            </div>

        </div>

        <div class="section-title">🍊 رقم و درجه‌بندی</div>
        <div class="col-12 mb-3">
            <div id="sortingItems">
                <div class="row border rounded p-3 mb-2 sorting-item">
                    <div class="col-md-5 mb-2">
                        <label class="form-label">محصول / رقم</label>
                        <select name="items[0].VarietyId" class="form-select" required>
                            <option value="">-- انتخاب محصول و رقم --</option>
                            @foreach (var variety in (ViewBag.VarietyList as SelectList) ?? new SelectList(Enumerable.Empty<SelectListItem>()))
                            {
                                <option value="@variety.Value">@variety.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 mb-2">
                        <label class="form-label">درجه</label>
                        <select name="items[0].Grade" class="form-select" required>
                            <option value="">-- انتخاب درجه --</option>
                            <option value="درجه یک">درجه یک</option>
                            <option value="درجه دو">درجه دو</option>
                            <option value="درهم">درهم</option>
                            <option value="ضایعات">ضایعات</option>
                        </select>
                    </div>
                    <div class="col-md-2 mb-2">
                        <label class="form-label">تعداد سبد</label>
                        <input name="items[0].BasketCount" type="number" min="1" class="form-control" required />
                    </div>
                    <div class="col-md-2 d-flex align-items-end mb-2">
                        <button type="button" class="btn btn-outline-danger w-100 remove-sorting-item" onclick="removeSortingItem(this)" disabled>حذف</button>
                    </div>
                </div>
            </div>
            <button type="button" class="btn btn-outline-primary btn-sm" onclick="addSortingItem()">➕ افزودن رقم / درجه دیگر</button>
            <div class="form-text">برای هر رقم و درجه، تعداد سبد جداگانه ثبت می‌شود.</div>
        </div>
        <div class="row">
            <div class="col-md-3 mb-3">
                <label asp-for="FarmName" class="form-label"></label>
                <input asp-for="FarmName" class="form-control @(perms.GetValueOrDefault("FarmName") ? "" : "readonly-field")" readonly="@(!perms.GetValueOrDefault("FarmName"))" placeholder="نام مزرعه..." />
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="Source" class="form-label"></label>
                <input asp-for="Source" class="form-control @(perms.GetValueOrDefault("Source") ? "" : "readonly-field")" readonly="@(!perms.GetValueOrDefault("Source"))" placeholder="مبدا..." />
            </div>
        </div>

        <div class="section-title">🚛 حمل و مقصد</div>
        <div class="row">
            <div class="col-md-3 mb-3">
                <label asp-for="Destination" class="form-label"></label>
                <input asp-for="Destination" class="form-control @(perms.GetValueOrDefault("Destination") ? "" : "readonly-field")" readonly="@(!perms.GetValueOrDefault("Destination"))" list="destList" />
                <datalist id="destList"><option value="سردخانه"></option><option value="بازار"></option></datalist>
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="SaleType" class="form-label"></label>
                <select asp-for="SaleType" class="form-select @(perms.GetValueOrDefault("SaleType") ? "" : "readonly-field")" disabled="@(!perms.GetValueOrDefault("SaleType"))">
                    <option value="">-- انتخاب نوع فروش --</option>
                    <option value="نقدی">نقدی</option>
                    <option value="میدان">میدان</option>
                    <option value="هدیه">هدیه</option>
                    <option value="جابجایی">جابجایی (انتقال داخلی)</option>
                </select>
                @if (!perms.GetValueOrDefault("SaleType"))
                {
                    <input type="hidden" asp-for="SaleType" />
                }
            </div>
            <div class="col-md-3 mb-3">
                @{ var exitAllowed = FruitBilling.Web.Models.SortingMovement.AllowedExitTypes(Model.SaleType); }
                <label asp-for="MovementType" class="form-label"></label>
                <select asp-for="MovementType" class="form-select @(perms.GetValueOrDefault("MovementType") ? "" : "readonly-field")" disabled="@(!perms.GetValueOrDefault("MovementType"))">
                    @if (exitAllowed.Length != 1)
                    {
                        <option value="">@(exitAllowed.Length == 0 ? "-- ابتدا نوع فروش را انتخاب کنید --" : "-- انتخاب نوع خروج --")</option>
                    }
                    @foreach (var opt in exitAllowed)
                    {
                        <option value="@opt">@opt</option>
                    }
                </select>
                @if (!perms.GetValueOrDefault("MovementType"))
                {
                    <input type="hidden" asp-for="MovementType" />
                }
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="VehiclePlate" class="form-label"></label>
                <input asp-for="VehiclePlate" class="form-control @(perms.GetValueOrDefault("VehiclePlate") ? "" : "readonly-field")" readonly="@(!perms.GetValueOrDefault("VehiclePlate"))" />
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="SortingContractor" class="form-label"></label>
                <input asp-for="SortingContractor" class="form-control @(perms.GetValueOrDefault("SortingContractor") ? "" : "readonly-field")" readonly="@(!perms.GetValueOrDefault("SortingContractor"))" />
            </div>
            <div class="col-md-12 mb-3">
                <label asp-for="Description" class="form-label"></label>
                <input asp-for="Description" class="form-control @(perms.GetValueOrDefault("Description") ? "" : "readonly-field")" readonly="@(!perms.GetValueOrDefault("Description"))" />
            </div>
        </div>

        <div class="text-end mt-4">
            <button type="submit" class="btn btn-primary">💾 ثبت و صدور برگه</button>
            <a asp-action="Index" asp-route-cycleId="@Model.HarvestCycleId" class="btn btn-secondary">بازگشت</a>
        </div>
    </form>
</div>

<script>
    (function () {
        var map = @Json.Serialize(FruitBilling.Web.Models.SortingMovement.SaleTypes.ToDictionary(s => s, s => FruitBilling.Web.Models.SortingMovement.AllowedExitTypes(s)));
        var sale = document.querySelector('select[name="SaleType"]');
        var exit = document.querySelector('select[name="MovementType"]');
        if (!sale || !exit || exit.disabled) return;

        function sync() {
            var current = exit.value;
            var list = map[sale.value] || [];
            exit.innerHTML = '';
            if (list.length !== 1) {
                var ph = document.createElement('option');
                ph.value = '';
                ph.textContent = list.length ? '-- انتخاب نوع خروج --' : '-- ابتدا نوع فروش را انتخاب کنید --';
                exit.appendChild(ph);
            }
            list.forEach(function (t) {
                var o = document.createElement('option');
                o.value = t;
                o.textContent = t;
                exit.appendChild(o);
            });
            exit.value = list.indexOf(current) >= 0 ? current : (list.length === 1 ? list[0] : '');
            exit.required = list.length > 1;
        }

        sale.addEventListener('change', sync);
        sync();
    })();
</script>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function refreshSortingItems() {
            const rows = document.querySelectorAll('#sortingItems .sorting-item');
            rows.forEach((row, index) => {
                row.querySelector('.col-md-5 select').name = `items[${index}].VarietyId`;
                row.querySelector('.col-md-3 select').name = `items[${index}].Grade`;
                row.querySelector('input[type="number"]').name = `items[${index}].BasketCount`;
                row.querySelector('.remove-sorting-item').disabled = rows.length === 1;
            });
        }
        function addSortingItem() {
            const first = document.querySelector('#sortingItems .sorting-item');
            const clone = first.cloneNode(true);
            clone.querySelectorAll('select').forEach(select => select.selectedIndex = 0);
            clone.querySelector('input[type="number"]').value = '';
            document.getElementById('sortingItems').appendChild(clone);
            refreshSortingItems();
        }
        function removeSortingItem(button) {
            if (document.querySelectorAll('#sortingItems .sorting-item').length <= 1) return;
            button.closest('.sorting-item').remove();
            refreshSortingItems();
        }
        refreshSortingItems();
    </script>
}

<partial name="_ValidationHighlights" />
