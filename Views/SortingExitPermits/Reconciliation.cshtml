@model FruitBilling.Web.Models.PermitReconciliationViewModel
@{
    ViewData["Title"] = "گزارش تطبیق خروج مزرعه و سورتینگ";
    var cycles = ViewBag.Cycles as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
}
<style>
    .recon-summary { display:grid; grid-template-columns:repeat(auto-fit,minmax(145px,1fr)); gap:12px; margin:18px 0; }
    .recon-card { border:1px solid #dee2e6; border-radius:10px; padding:14px; background:#fff; }
    .recon-number { font-size:1.6rem; font-weight:700; }
    .recon-table th { white-space:nowrap; background:#f4f6f8; }
    .recon-table td { vertical-align:middle; }
    .recon-details { min-width:230px; white-space:normal; }
    .status-ok { background:#e2f3e5!important; }
    .status-warning { background:#fff3cd!important; }
    .status-error { background:#f8d7da!important; }
    .status-muted { background:#e9ecef!important; }
    @@media(max-width:768px) { .recon-table { font-size:.82rem; } }
</style>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h2 class="mb-1">🔎 گزارش تطبیق خروج مزرعه و سورتینگ</h2>
        <div class="text-muted">دوره: @(Model.HarvestCycleName ?? "—")</div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <form method="get" asp-action="ExportReconciliation">
            <input type="hidden" name="cycleId" value="@Model.HarvestCycleId" />
            <button type="submit" class="btn btn-success">⬇ دریافت گزارش اکسل</button>
        </form>
        <a asp-action="Index" class="btn btn-outline-secondary">بازگشت به فهرست سورتینگ</a>
    </div>
</div>

<div class="alert alert-info">
    این گزارش فقط خواندنی است و هیچ اطلاعاتی را اصلاح یا حذف نمی‌کند.
    تطبیق بر اساس شماره قبض، تاریخ، پلاک و شناسه رقم انجام می‌شود؛ شماره قبض به‌تنهایی معیار تطبیق نیست.
    فقط برگ‌های مزرعه با مقصد سورتینگ و برگ‌های سورتینگ با نوع خروج «خروج برای سورت» بررسی می‌شوند.
</div>

<form method="get" asp-action="Reconciliation" class="card card-body mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label" for="cycleId">دوره برداشت</label>
            <select id="cycleId" name="cycleId" asp-items="cycles" class="form-select">
                <option value="0">برگه‌های بدون دوره</option>
            </select>
        </div>
        <div class="col-md-auto">
            <button type="submit" class="btn btn-primary">نمایش گزارش</button>
        </div>
    </div>
</form>

<div class="recon-summary">
    <div class="recon-card"><div class="text-muted">تطبیق کامل</div><div class="recon-number text-success">@Model.MatchedCount</div></div>
    <div class="recon-card"><div class="text-muted">مغایرت اطلاعات</div><div class="recon-number text-danger">@Model.MismatchCount</div></div>
    <div class="recon-card"><div class="text-muted">فاقد طرف مقابل</div><div class="recon-number text-warning">@Model.MissingCount</div></div>
    <div class="recon-card"><div class="text-muted">تطبیق مبهم</div><div class="recon-number text-warning">@Model.AmbiguousCount</div></div>
    <div class="recon-card"><div class="text-muted">اطلاعات ناکافی</div><div class="recon-number">@Model.IncompleteCount</div></div>
</div>

@if (Model.Rows.Count == 0)
{
    <div class="alert alert-secondary">برای این دوره، قبضی با شرایط بررسی‌شده پیدا نشد.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered table-hover recon-table">
            <thead>
                <tr>
                    <th>وضعیت</th>
                    <th>شماره قبض</th>
                    <th>تاریخ</th>
                    <th>پلاک</th>
                    <th>محصول / رقم</th>
                    <th>برگ خروج مزرعه</th>
                    <th>برگ خروج سورتینگ</th>
                    <th>سبد مزرعه</th>
                    <th>سبد سورتینگ</th>
                    <th>وزن خالی مزرعه / سورتینگ</th>
                    <th>وزن پر مزرعه / سورتینگ</th>
                    <th>شرح بررسی</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var row in Model.Rows)
            {
                var css = row.Status == "تطبیق کامل" ? "status-ok"
                    : row.Status == "مغایرت اطلاعات" || row.Status == "فاقد طرف مقابل" ? "status-error"
                    : row.Status == "تطبیق مبهم" || row.Status == "اطلاعات ناکافی" ? "status-warning" : "";
                <tr class="@css">
                    <td><strong>@row.Status</strong></td>
                    <td>@(string.IsNullOrWhiteSpace(row.TicketNo) ? "—" : row.TicketNo)</td>
                    <td>@(string.IsNullOrWhiteSpace(row.Date) ? "—" : row.Date)</td>
                    <td>@(string.IsNullOrWhiteSpace(row.VehiclePlate) ? "—" : row.VehiclePlate)</td>
                    <td>@row.ProductName / @row.VarietyName</td>
                    <td>@(string.IsNullOrWhiteSpace(row.FarmPermitNumber) ? "—" : row.FarmPermitNumber)</td>
                    <td>@(string.IsNullOrWhiteSpace(row.SortingPermitNumber) ? "—" : row.SortingPermitNumber)</td>
                    <td>@(row.FarmBasketCount?.ToString() ?? "—")</td>
                    <td>@(row.SortingBasketCount?.ToString() ?? "—")</td>
                    <td>@(row.FarmEmptyWeight?.ToString("N0") ?? "—") / @(row.SortingEmptyWeight?.ToString("N0") ?? "—")</td>
                    <td>@(row.FarmGrossWeight?.ToString("N0") ?? "—") / @(row.SortingGrossWeight?.ToString("N0") ?? "—")</td>
                    <td class="recon-details">@row.Details</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
