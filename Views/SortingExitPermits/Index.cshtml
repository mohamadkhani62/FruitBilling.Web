@model IEnumerable<FruitBilling.Web.Models.SortingExitPermit>
@inject FruitBilling.Web.Services.IPermissionService PermissionService
@inject Microsoft.AspNetCore.Identity.UserManager<Microsoft.AspNetCore.Identity.IdentityUser> UserManager

@{
    ViewData["Title"] = "مجوزهای تحویل سورتینگ";

    int currentPage = Convert.ToInt32(ViewBag.Page);
    if (currentPage == 0) currentPage = 1;

    int size = Convert.ToInt32(ViewBag.PageSize);
    if (size == 0) size = 50;

    int total = Convert.ToInt32(ViewBag.Total);
    int totalPages = (int)Math.Ceiling((double)total / size);

    int rowNumber = ((currentPage - 1) * size) + 1;
    int focusId = ViewBag.FocusId != null ? Convert.ToInt32(ViewBag.FocusId) : 0;

    int selectedCycleId = ViewBag.SelectedCycleId != null ? Convert.ToInt32(ViewBag.SelectedCycleId) : 0;
    var currentCycle = ViewBag.CurrentCycle as FruitBilling.Web.Models.HarvestCycle;
    string createHref = selectedCycleId > 0 ? $"/SortingExitPermits/Create?cycleId={selectedCycleId}" : "/SortingExitPermits/Create";

    // 🆕 بررسی دسترسی کاربر برای تأیید فروش
    var currentUserId = UserManager.GetUserId(User)!;
    bool canApprove = await PermissionService.CanApproveAsync(currentUserId, "SortingExitPermits");
}

<style>
    body {
        direction: rtl;
        font-family: 'B Titr';
    }

    table {
        direction: rtl;
        font-family:'B Nazanin';
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
        font-weight:500;
    }

    th, td {
        border: 1px solid #ccc;
        padding: 6px;
        text-align: center;
    }

    th {
        background: #f0f0f0;
        white-space: nowrap;
    }

    .badge-pending {
        background: #ff9800;
        color: white;
        padding: 3px 8px;
        border-radius: 4px;
    }

    .badge-done {
        background: #4caf50;
        color: white;
        padding: 3px 8px;
        border-radius: 4px;
    }

    .badge-ok {
        background: blue;
        color: white;
        padding: 3px 8px;
        border-radius: 4px;
    }

    /* استایل فوکوس */
    .focus-row {
        background-color: #fff3cd !important;
        transition: background-color 1s ease;
    }

    .desc-col {
        max-width: 150px;
        font-size: 12px;
        color: #555;
        text-align: right;
        white-space: normal;
    }
</style>

<h2>🍏 فهرست مجوزهای تحویل سورتینگ</h2>

<!-- 🆕 انتخاب دوره برداشت -->
<div class="card mb-3 shadow-sm" style="background: #f8f9fa;">
    <div class="card-body">
        <form method="get" class="row align-items-end">
            <div class="col-md-6">
                <label class="form-label fw-bold">📅 انتخاب دوره برداشت:</label>
                <select name="cycleId" asp-items="ViewBag.Cycles" class="form-select" onchange="this.form.submit()"></select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary">نمایش رکوردها</button>
            </div>
        </form>
    </div>
</div>

@if (currentCycle != null)
{
    <h5 class="text-success mb-3">🌱 رکوردهای دوره: @currentCycle.Name (@currentCycle.Year)</h5>
}
else
{
    <h5 class="text-secondary mb-3">📁 برگه‌های بدون دوره (داده‌های قدیمی)</h5>
}

@if (TempData["Msg"] != null)
{
    <div id="topAlert" class="alert alert-success" style="transition: all 0.5s;">✅ @TempData["Msg"]</div>
}
@if (TempData["Warning"] != null)
{
    <div id="topAlert" class="alert alert-warning" style="transition: all 0.5s; font-weight: bold;">⚠️ @TempData["Warning"]</div>
}

<!-- 🆕 بخش تأیید گروهی -->
@if (canApprove && ViewBag.PendingApprovalCount > 0)
{
    int pendingCount = (int)ViewBag.PendingApprovalCount;
    <div class="alert alert-warning" style="border-right: 5px solid #ff9800;">
        <h5 class="mb-2">⏳ <strong>@pendingCount</strong> برگه در انتظار تأیید فروش است.</h5>

        <form asp-action="ApproveAll" method="post" class="row g-2 align-items-end" onsubmit="return confirm('آیا از تأیید برگه‌ها مطمئن هستید؟')">
            @Html.AntiForgeryToken()
            <input type="hidden" name="cycleId" value="@selectedCycleId" />

            <div class="col-md-3">
                <label class="form-label small">از تاریخ (اختیاری)</label>
                <input type="text" name="fromDate" class="form-control form-control-sm" placeholder="1404/01/01" />
            </div>
            <div class="col-md-3">
                <label class="form-label small">تا تاریخ (اختیاری)</label>
                <input type="text" name="toDate" class="form-control form-control-sm" placeholder="1404/12/29" />
            </div>
            <div class="col-md-6">
                <button type="submit" class="btn btn-success">✅ تأیید برگه‌های فیلترشده</button>
                <button type="submit" class="btn btn-outline-success" onclick="document.querySelector('[name=fromDate]').value=''; document.querySelector('[name=toDate]').value=''">
                    تأیید همه (بدون فیلتر)
                </button>
            </div>
        </form>
    </div>
}
<div class="d-flex justify-content-between mb-3">
    <div>
        @if (selectedCycleId > 0)
        {
            <a asp-action="Create" asp-route-cycleId="@selectedCycleId" class="btn btn-primary">➕ صدور مجوز تحویل سورتینگ</a>
        }
        else
        {
            <button type="button" class="btn btn-primary" disabled title="برای صدور برگه جدید یک دوره انتخاب کنید">➕ صدور برگ خروج سورتینگ</button>
        }
    </div>
    <div>
        <a asp-action="Export" asp-route-cycleId="@selectedCycleId" class="btn btn-success">📥 خروجی اکسل</a>
        <a asp-action="Export" class="btn btn-outline-success">📥 همه‌ی دوره‌ها</a>
        <a asp-action="Import" class="btn btn-warning">📤 ورود یکپارچه اکسل</a>
    </div>
</div>

<table style="padding: 2px;">
    <thead>
        <tr>
            <th>ردیف</th>
            <th>تاریخ</th>
            <th>مجوز تحویل</th>
            <th>قبض باسکول</th>
            <th>نوع محصول</th>
            <th>درجه</th>
            <th>مبدا</th>
            <th>مقصد</th>
            <th>نوع خروج</th>
            <th>نوع فروش</th>
            <th>پیمانکار</th>
            <th>تعداد سبد</th>
            <th>پلاک</th>
            <th>وزن خالص</th>
            <th>وضعیت</th>
            <th>توضیحات</th>
            <th>عملیات</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="17" class="text-muted">هیچ برگه‌ای در این دوره ثبت نشده است.</td></tr>
        }
        @foreach (var item in Model)
        {
            if (item.Items == null || !item.Items.Any())
            {
                var totalNet = item.BasculTickets?.Sum(t => t.NetWeight) ?? 0;
                var ticketNos = item.BasculTickets != null ? string.Join(" | ", item.BasculTickets.Select(t => t.TicketNo)) : "";
                <tr id="record-@item.Id" class="@(item.Id == focusId ? "focus-row" : "")">
                    <td>@rowNumber</td><td>@item.Date</td><td><b>@item.PermitNumber</b></td><td>@ticketNos</td><td>@item.ProductType</td><td>@item.Grade</td><td>@item.Source</td><td>@item.Destination</td>
                    <td>@FruitBilling.Web.Models.SortingMovement.ExitLabel(item.SaleType, item.MovementType)</td><td>@item.SaleType</td><td>@item.SortingContractor</td><td>@item.BasketCount</td><td>@item.VehiclePlate</td><td>@(totalNet > 0 ? totalNet.ToString("N0") : "-")</td><td>@item.Status</td><td class="desc-col">@item.Description</td>
                    <td><a asp-action="Print" asp-route-id="@item.Id" class="btn btn-info btn-sm" target="_blank">🖨️</a> <a asp-action="Edit" asp-route-id="@item.Id" asp-route-page="@currentPage" asp-route-focusId="@item.Id" class="btn btn-primary btn-sm">✏️</a></td>
                </tr>
                rowNumber++;
            }
            else
            {
                foreach (var detail in item.Items)
                {
                    var totalNet = detail.BasculTickets?.Sum(t => t.NetWeight) ?? 0;
                    var ticketNos = detail.BasculTickets != null ? string.Join(" | ", detail.BasculTickets.Select(t => t.TicketNo)) : "";
                    <tr class="@(item.Id == focusId ? "focus-row" : "")" style="background-color:@(rowNumber % 2 == 0 ? "#f5f9ff" : "#ffffff")">
                        <td>@rowNumber</td><td>@item.Date</td><td><b>@item.PermitNumber</b></td><td>@ticketNos</td><td>@(detail.Variety?.Product?.Name ?? "-") - @(detail.Variety?.Name ?? "-")</td><td>@detail.Grade</td><td>@item.Source</td><td>@item.Destination</td>
                        <td>@FruitBilling.Web.Models.SortingMovement.ExitLabel(item.SaleType, item.MovementType)</td><td>@item.SaleType</td><td>@item.SortingContractor</td><td>@detail.BasketCount</td><td>@item.VehiclePlate</td><td>@(totalNet > 0 ? totalNet.ToString("N0") : "-")</td><td>@item.Status</td><td class="desc-col">@item.Description</td>
                        <td><a asp-action="Weigh" asp-route-id="@item.Id" class="btn btn-warning btn-sm">⚖️</a> <a asp-action="Print" asp-route-id="@item.Id" class="btn btn-info btn-sm" target="_blank">🖨️</a> <a asp-action="Edit" asp-route-id="@item.Id" asp-route-page="@currentPage" asp-route-focusId="@item.Id" class="btn btn-primary btn-sm">✏️</a></td>
                    </tr>
                    rowNumber++;
                }
            }
        }
    </tbody>
</table>

<partial name="_RowHighlight" />

<!-- صفحه‌بندی -->
<nav class="mt-3">
    @for (int i = 1; i <= totalPages; i++)
    {
        <a class="btn btn-sm @(i == currentPage ? "btn-primary" : "btn-outline-secondary")"
           asp-action="Index" asp-route-cycleId="@selectedCycleId" asp-route-page="@i">@i</a>
    }
</nav>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // ==========================================
            // ۱. ساخت دکمه شناور (FAB) - اضافه به body
            // ==========================================
            var fab = document.createElement('a');
            fab.href = '@createHref';
            fab.title = 'صدور برگ خروج سورتینگ';
            fab.innerHTML = '➕';

            Object.assign(fab.style, {
                position: 'fixed',
                bottom: '30px',
                left: '30px',
                width: '35px',
                height: '35px',
                backgroundColor: '#28a745',
                color: 'white',
                borderRadius: '50%',
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'center',
                fontSize: '24x',
                fontWeight: 'bold',
                boxShadow: '0 4px 15px rgba(0,0,0,0.3)',
                textDecoration: 'none',
                zIndex: '9999',
                cursor: 'pointer',
                fontFamily: 'Arial, sans-serif',
                lineHeight: '1'
            });

            fab.addEventListener('mouseenter', function () {
                fab.style.backgroundColor = '#218838';
                fab.style.transform = 'scale(1.12)';
            });
            fab.addEventListener('mouseleave', function () {
                fab.style.backgroundColor = '#28a745';
                fab.style.transform = 'scale(1)';
            });

            document.body.appendChild(fab);

        });
    </script>
}